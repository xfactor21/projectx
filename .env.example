# project.X integration environment
# Never commit private tokens. Copy these values into the deployment environment settings.

# Legacy owner-only Vercel fallback. New production users connect their own account.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
# Comma-separated Supabase user IDs allowed to read or deploy through the owner Vercel account.
PROJECTX_ALLOWED_USER_IDS=

# Production provider connection service (server-side only)
SUPABASE_SERVICE_ROLE_KEY=
PROJECTX_API_ORIGIN=
PROJECTX_OAUTH_STATE_SECRET=
# Base64-encoded random 32-byte key. Rotating it requires reauthorizing provider accounts.
PROJECTX_PROVIDER_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=

# Supabase cloud + companion sync
# Public URL for the production Supabase project.
VITE_SUPABASE_URL=
# Browser-safe publishable key only. Never use service_role/secret keys here.
VITE_SUPABASE_PUBLISHABLE_KEY=
